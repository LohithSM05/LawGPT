PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/lawgpt
CLIENT_URL=http://localhost:5173
PYTHON_AI_SERVICE_URL=http://localhost:8000

# Module 4 — root directory for uploaded case documents. Defaults to
# <repo>/backend/uploads if unset. Gitignored; never commit uploads.
UPLOADS_DIR=

# Module 4 Phase 2 — document pipeline worker. The backend polls MongoDB for
# documents with status 'pending' and hands each to the python-ai service.
# polling interval between ticks, and how old an in-flight 'processing'
# record must be before it's treated as a crashed job and requeued.
DOC_PIPELINE_POLL_INTERVAL_MS=5000
DOC_PROCESSING_TIMEOUT_MS=600000

# Module 2 requires separate access + refresh secrets (Module 1's single
# JWT_SECRET/JWT_EXPIRES_IN pair is replaced by these four vars).
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=lawgpt_refresh_token

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
